# TEST ONLY. Install as /etc/moonpasskey/reference-rp.env, owner root:root mode 0600.
# systemd EnvironmentFile syntax: KEY=value, no export, shell substitutions, or source.
# start.mjs does not load this file itself. These are exact deployment values.
REFERENCE_RP_PORT=8787
REFERENCE_RP_ORIGIN=https://passkey-test.ksuser.cn
REFERENCE_RP_ID=passkey-test.ksuser.cn
REFERENCE_RP_UV=required
REFERENCE_RP_COUNTER=report-only
REFERENCE_RP_CORE=/opt/moonpasskey/current/_build/js/release/build/analysis/analysis.js
REFERENCE_RP_DB=/var/lib/moonpasskey/reference-rp.sqlite
REFERENCE_RP_TLS_CERT=/etc/moonpasskey/tls/backend/backend.crt
REFERENCE_RP_TLS_KEY=/etc/moonpasskey/tls/backend/backend.key
# Public CA input for offline preflight; start.mjs uses only the leaf and key.
REFERENCE_RP_TLS_CA=/etc/moonpasskey/tls/backend-ca.crt
# Never give this service the CA signing key.
